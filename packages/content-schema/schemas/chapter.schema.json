{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shivam2003.com/schemas/chapter.schema.json",
  "title": "Learning Hub Chapter",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "title",
    "slug",
    "subject",
    "chapterNumber",
    "summary",
    "learningObjectives",
    "prerequisites",
    "estimatedReadingMinutes",
    "difficulty",
    "tags",
    "relatedChapters",
    "recommendedPapers",
    "authors",
    "reviewers",
    "wordCount",
    "citationStatus",
    "codeStatus",
    "mathReviewStatus",
    "editorialStatus",
    "createdAt",
    "updatedAt",
    "lastVerifiedAt"
  ],
  "properties": {
    "title": { "type": "string", "minLength": 3 },
    "slug": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "subject": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "chapterNumber": { "type": "integer", "minimum": 1 },
    "classification": {
      "enum": ["official", "prerequisite", "supplementary", "advanced-extension", "industry-application"]
    },
    "summary": { "type": "string", "minLength": 40 },
    "learningObjectives": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "prerequisites": { "type": "array", "items": { "type": "string" } },
    "estimatedReadingMinutes": { "type": "integer", "minimum": 1 },
    "difficulty": { "enum": ["foundation", "intermediate", "advanced"] },
    "tags": { "type": "array", "items": { "type": "string" } },
    "relatedChapters": { "type": "array", "items": { "type": "string" } },
    "recommendedPapers": { "type": "array", "items": { "type": "string" } },
    "authors": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "reviewers": { "type": "array", "items": { "type": "string" } },
    "wordCount": { "type": "integer", "minimum": 0 },
    "citationStatus": { "enum": ["unverified", "partial", "verified"] },
    "codeStatus": { "enum": ["not-applicable", "draft", "tested"] },
    "mathReviewStatus": { "enum": ["not-applicable", "pending", "passed", "failed"] },
    "editorialStatus": { "enum": ["draft", "review", "approved"] },
    "createdAt": { "type": "string", "format": "date" },
    "updatedAt": { "type": "string", "format": "date" },
    "lastVerifiedAt": { "type": "string", "format": "date" }
  }
}
