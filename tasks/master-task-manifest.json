  "qualityGates": {
    "mandatoryForChapterApproval": [
      "At least 3000 meaningful prose words",
      "Matches the official syllabus or labels additions as prerequisite, supplementary, advanced extension, or industry application",
      "Original writing",
      "No fabricated references",
      "External links valid at verification time",
      "DOI or paper identifier verified where available",
      "Mathematical notation validated",
      "Code tested",
      "Heading structure valid",
      "Metadata valid",
      "Accessibility checks passed",
      "Grammar and readability review passed",
      "Research-paper recommendations relevant",
      "Claims supported by citations",
      "No repeated filler",
      "No unresolved placeholders",
      "No internal agent instructions in published text"
    ],
    "requiredStatuses": [
      "planned",
      "researching",
      "drafting",
      "technical-review",
      "citation-review",
      "editorial-review",
      "approved",
      "published",
      "needs-update",
      "blocked"
    ],
    "mergePolicy": {
      "directPushToMain": false,
      "subjectLeadApprovalRequired": true,
      "academicEditorApprovalRequired": true,
      "citationVerifierApprovalRequired": true,
      "fullSiteChecksBeforeMain": true
