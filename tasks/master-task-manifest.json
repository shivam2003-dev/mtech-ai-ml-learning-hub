    "retryPolicy": {
      "maximumAttempts": 3,
      "backoff": "exponential",
      "reduceTaskSizeAfterRepeatedFailure": true,
      "preserveCompletedWork": true,
      "releaseLocksOnFailure": true,
      "reassignWorkerWhenSafe": true,
      "escalateAfterExhaustion": true
    },
    "deduplicationKeys": [
      "taskId",
      "allowedOutputRoot",
      "DOI",
      "arXiv ID",
      "Semantic Scholar paper ID",
      "normalized title plus first author"
    ],
    "requiredTaskFields": [
