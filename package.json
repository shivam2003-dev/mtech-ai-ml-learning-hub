{
  "name": "shivam-mtech-ai-ml-learning-hub",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "NODE_ENV=development next dev --webpack",
    "build": "npm run build:pages",
    "build:pages": "NODE_ENV=production next build --webpack",
    "validate:foundation": "node scripts/validate-content/foundation.mjs",
    "validate:links": "node scripts/validate-links/internal-static-links.mjs out",
    "count:chapter": "node scripts/calculate-word-count/chapter-word-count.mjs",
    "test": "GITHUB_PAGES=true GITHUB_REPOSITORY=shivam2003-dev/mtech-ai-ml-learning-hub npm run build:pages && node --test tests/rendered-html.test.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next --ignore-pattern .worktrees"
  },
  "dependencies": {
    "@shikijs/rehype": "^4.3.1",
    "gray-matter": "^4.0.3",
    "next": "^16.2.12",
    "next-mdx-remote": "^6.0.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-mathjax": "^7.1.0",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "shiki": "^4.3.1",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "^9.39.4",
    "eslint-config-next": "16.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3"
  },
  "overrides": {
    "postcss": "8.5.23",
    "sharp": "0.35.3"
  },
  "type": "module"
}
